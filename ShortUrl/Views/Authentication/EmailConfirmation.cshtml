@model ShortUrl.Data.ViewModel.ConfirmEmailLoginVm
@{
    ViewData["Title"] = "Cofirm  your account";
}


<div class="row">
    <div class="col-md-6 offset-md-3">
        <h4 class="form-header">Confirm your account </h4>
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <form asp-controller="Authentication" asp-action="SendEmailConfirmation" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="EmailAddress"></label>
                        <input asp-for="EmailAddress" class="form-control" placeholder="Enter email" id="emailAddress" />
                        <small class="form-text text-muted">We'll never share your email with anyone else</small> <br />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-outline-success mt-2 btn-login">
                     Confirm email
                    </button>
                </form>

            </div>
        </div>
    </div>

</div>
